# Model provider. step (default) uses the STEP_* variables below;
# openai uses any OpenAI-compatible Chat Completions endpoint.
LLM_PROVIDER=step

# Step OpenAI-compatible API. Keep model deployment configurable.
STEP_API_KEY=
STEP_BASE_URL=https://api.stepfun.com/v1
STEP_MODEL=step-3.7-flash
STEP_CONNECT_TIMEOUT_SECONDS=10
STEP_READ_TIMEOUT_SECONDS=90
STEP_MAX_RETRIES=3


# Generic OpenAI-compatible provider (used when LLM_PROVIDER=openai).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional NCBI identity/rate-limit key.
NCBI_API_KEY=
# Contact email required by NCBI E-utilities usage policy.
NCBI_EMAIL=

# All generated artifacts stay outside Git.
TARGET_AGENT_RUN_DIR=runs
RESEARCH_AGENT_PROJECT_DIR=projects
TARGET_AGENT_CACHE_DIR=cache
TARGET_AGENT_INPUT_ROOT=data/input
TARGET_AGENT_TOOL_REGISTRY=configs/tool_registry.yaml
TARGET_AGENT_ENABLE_LIMMA=false
TARGET_AGENT_ENABLE_CENSUS_EXPRESSION=false
TARGET_AGENT_WEB_WORKERS=2
TARGET_AGENT_WEB_QUEUE_SIZE=8
TARGET_AGENT_GSEA_PERMUTATIONS=1000
TARGET_AGENT_RANDOM_SEED=123

# Best-practice skill catalog and planner hinting (P1).
TARGET_AGENT_SKILL_CATALOG=skills
TARGET_AGENT_SKILL_HINT_TOP_K=3
TARGET_AGENT_PATTERN_STORE=paper_strategy/patterns.jsonl
TARGET_AGENT_PATTERN_FEW_SHOT_TOP_K=3
TARGET_AGENT_PATTERN_NOMINATION=paper_strategy/nominations.jsonl

# Executable workflow templates (workflows/*.yaml drive planner and runtime).
TARGET_AGENT_WORKFLOW_CATALOG=workflows

# Persistent analysis kernels (explicit human/registered-tool sessions; LLM never auto-executes).
TARGET_AGENT_KERNEL_ENABLED=true
TARGET_AGENT_KERNEL_IDLE_TIMEOUT_SECONDS=600
TARGET_AGENT_KERNEL_EXEC_TIMEOUT_SECONDS=60
TARGET_AGENT_KERNEL_MAX_OUTPUT_CHARS=20000
TARGET_AGENT_KERNEL_MAX_CODE_CHARS=100000
# Optional explicit interpreters; empty means python / Rscript from PATH.
TARGET_AGENT_KERNEL_PYTHON=
TARGET_AGENT_KERNEL_R=
TARGET_AGENT_KERNEL_PORT=8765

# Optional bearer token for the web API (all /api/* except /healthz).
# Empty disables authentication; set a strong token before any remote exposure.
TARGET_AGENT_WEB_TOKEN=

# Optional token for the localhost kernel daemon (X-Kernel-Token or Bearer).
# Recommended on multi-user hosts; empty keeps the local process default.
TARGET_AGENT_KERNEL_TOKEN=
