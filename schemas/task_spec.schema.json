    "DatasetSelectionConstraint": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "2.2.0",
          "default": "2.2.0",
          "title": "Contract Version",
          "type": "string"
        },
        "preferred_dataset_accessions": {
          "items": {
            "type": "string"
          },
          "title": "Preferred Dataset Accessions",
          "type": "array"
        },
        "excluded_dataset_accessions": {
          "items": {
            "type": "string"
          },
          "title": "Excluded Dataset Accessions",
          "type": "array"
        },
        "omics_modes": {
          "items": {
            "enum": [
              "geo_bulk",
              "cellxgene",
              "local_single_cell"
            ],
            "type": "string"
          },
          "title": "Omics Modes",
          "type": "array"
        },
        "max_geo_candidates": {
          "default": 10,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Geo Candidates",
          "type": "integer"
        },
        "max_datasets_to_analyze": {
          "default": 2,
          "maximum": 2,
          "minimum": 1,
          "title": "Max Datasets To Analyze",
          "type": "integer"
        },
        "max_download_mb": {
          "default": 2048,
          "maximum": 10240,
          "minimum": 1,
          "title": "Max Download Mb",
          "type": "integer"
        },
        "max_cells": {
          "default": 100000,
          "maximum": 1000000,
          "minimum": 100,
          "title": "Max Cells",
          "type": "integer"
        },
        "min_biological_replicates_per_group": {
          "default": 3,
          "maximum": 20,
          "minimum": 3,
          "title": "Min Biological Replicates Per Group",
          "type": "integer"
        },
        "min_metadata_confidence": {
          "default": 0.8,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Metadata Confidence",
          "type": "number"
        },
        "allow_raw_sra": {
          "default": false,
          "title": "Allow Raw Sra",
          "type": "boolean"
        }
      },
      "title": "DatasetSelectionConstraint",
      "type": "object"
    },
    "EqtlColocalizationResultInput": {
      "additionalProperties": false,
