    "AnalysisEvidenceArtifact": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "2.2.0",
          "default": "2.2.0",
          "title": "Contract Version",
          "type": "string"
        },
        "relative_path": {
          "minLength": 1,
