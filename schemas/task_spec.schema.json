        "eqtl_study_id": {
          "minLength": 1,
          "title": "Eqtl Study Id",
          "type": "string"
        },
        "eqtl_ancestry": {
          "minLength": 1,
          "title": "Eqtl Ancestry",
          "type": "string"
        },
        "tissue": {
          "minLength": 1,
          "title": "Tissue",
          "type": "string"
        },
        "cell_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Type"
        },
        "molecular_trait": {
          "default": "gene_expression",
          "title": "Molecular Trait",
          "type": "string"
        },
        "minimum_variant_overlap_used": {
          "minimum": 1,
          "title": "Minimum Variant Overlap Used",
          "type": "integer"
        },
        "prior_p1": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Prior P1",
          "type": "number"
        },
        "prior_p2": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Prior P2",
          "type": "number"
        },
        "prior_p12": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Prior P12",
          "type": "number"
        },
        "sensitivity_analysis_passed": {
          "title": "Sensitivity Analysis Passed",
          "type": "boolean"
        },
        "sample_overlap": {
          "enum": [
            "none",
            "known",
            "unknown"
          ],
          "title": "Sample Overlap",
          "type": "string"
        },
        "sample_overlap_adjustment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Overlap Adjustment"
        },
        "columns": {
          "$ref": "#/$defs/ColocResultColumnMap"
        },
        "harmonized_variants": {
          "$ref": "#/$defs/HarmonizedVariantManifest"
        },
        "sensitivity_artifact": {
          "$ref": "#/$defs/AnalysisEvidenceArtifact"
        }
      },
      "required": [
        "asset_id",
        "relative_path",
        "sha256",
        "file_format",
        "genome_build",
        "study_id",
        "phenotype",
        "ancestry",
        "sample_size",
        "source_uri",
        "source_version",
        "method",
        "method_version",
        "gwas_study_id",
        "eqtl_study_id",
        "eqtl_ancestry",
        "tissue",
        "minimum_variant_overlap_used",
        "prior_p1",
        "prior_p2",
        "prior_p12",
        "sensitivity_analysis_passed",
        "sample_overlap",
        "columns",
        "harmonized_variants",
        "sensitivity_artifact"
      ],
      "title": "EqtlColocalizationResultInput",
      "type": "object"
