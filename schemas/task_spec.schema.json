          "enum": [
            "application/json",
            "text/tab-separated-values",
            "text/plain"
          ],
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "media_type"
      ],
      "title": "AnalysisEvidenceArtifact",
      "type": "object"
    },
