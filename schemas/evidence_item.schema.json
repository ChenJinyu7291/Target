{
  "$defs": {
    "ClaimClass": {
      "enum": [
        "FACT",
        "OBSERVED",
        "PREDICTED",
        "UNVERIFIED",
        "INFERRED"
      ],
      "title": "ClaimClass",
      "type": "string"
    },
    "EvidenceContext": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "2.2.0",
          "default": "2.2.0",
          "title": "Contract Version",
          "type": "string"
        },
        "organism": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organism"
        },
        "population": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population"
        },
        "tissue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tissue"
        },
        "cell_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Type"
        },
        "disease": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disease"
        },
        "disease_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disease Stage"
        },
        "assay": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assay"
        },
        "perturbation_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perturbation Type"
        },
        "genome_build": {
          "anyOf": [
            {
              "enum": [
                "GRCh37",
                "GRCh38"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Genome Build"
        },
        "ancestry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ancestry"
        },
        "locus_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locus Id"
        },
        "study_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Study Id"
        },
        "signal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signal Id"
        }
      },
      "title": "EvidenceContext",
      "type": "object"
    },
    "GeneticEvidencePayload": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "2.2.0",
          "default": "2.2.0",
          "title": "Contract Version",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "gwas_association",
            "fine_mapping",
            "colocalization",
            "locus_to_gene",
            "open_targets_genetic_association"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "analysis_level": {
          "enum": [
            "association_only",
            "fine_mapped",
            "colocalization_supported",
            "database_aggregate"
          ],
          "title": "Analysis Level",
          "type": "string"
        },
        "study_id": {
          "title": "Study Id",
          "type": "string"
        },
        "molecular_study_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Molecular Study Id"
        },
        "locus_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locus Id"
        },
        "variant_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Id"
        },
        "signal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signal Id"
        },
        "gene_symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gene Symbol"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "method_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method Version"
        },
        "strength": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Strength",
          "type": "number"
        },
        "formal_score_eligible": {
          "title": "Formal Score Eligible",
          "type": "boolean"
        },
        "causal_status": {
          "const": "not_established",
          "default": "not_established",
          "title": "Causal Status",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "evidence_type",
        "analysis_level",
        "study_id",
        "strength",
        "formal_score_eligible"
      ],
      "title": "GeneticEvidencePayload",
      "type": "object"
    },
    "SourceLocator": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "2.2.0",
          "default": "2.2.0",
          "title": "Contract Version",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version_meta": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Meta"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "start_char": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Char"
        },
        "end_char": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Char"
        }
      },
      "required": [
        "uri",
        "source_id"
      ],
      "title": "SourceLocator",
      "type": "object"
    },
    "Stance": {
      "enum": [
        "supports",
        "refutes",
        "mixed",
        "uncertain"
      ],
      "title": "Stance",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "2.2.0",
      "default": "2.2.0",
      "title": "Contract Version",
      "type": "string"
    },
    "evidence_id": {
      "title": "Evidence Id",
      "type": "string"
    },
    "tool_run_id": {
      "minLength": 1,
      "title": "Tool Run Id",
      "type": "string"
    },
    "gene_symbol": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gene Symbol"
    },
    "claim_class": {
      "$ref": "#/$defs/ClaimClass"
    },
    "statement": {
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceLocator"
    },
    "source_span": {
      "minLength": 1,
      "title": "Source Span",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/EvidenceContext"
    },
    "stance": {
      "$ref": "#/$defs/Stance",
      "default": "uncertain"
    },
    "effect_direction": {
      "default": "unclear",
      "enum": [
        "increase",
        "decrease",
        "mixed",
        "unclear"
      ],
      "title": "Effect Direction",
      "type": "string"
    },
    "effect": {
      "additionalProperties": true,
      "title": "Effect",
      "type": "object"
    },
    "uncertainty": {
      "minLength": 1,
      "title": "Uncertainty",
      "type": "string"
    },
    "quality_flags": {
      "items": {
        "type": "string"
      },
      "title": "Quality Flags",
      "type": "array"
    },
    "context_match_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Context Match Score",
      "type": "number"
    },
    "context_match": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Match"
    },
    "genetic_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeneticEvidencePayload"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "tool_run_id",
    "claim_class",
    "statement",
    "source",
    "source_span",
    "context",
    "uncertainty",
    "context_match_score"
  ],
  "title": "EvidenceItem",
  "type": "object"
}
