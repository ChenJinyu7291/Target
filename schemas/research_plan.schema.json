{
  "$defs": {
    "AssessmentLevel": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "human"
      ],
      "title": "AssessmentLevel",
      "type": "string"
    },
    "DataContract": {
      "additionalProperties": false,
      "description": "Small deterministic boundary contract; no runtime JSON-schema dependency.",
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "schema_id": {
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "required_fields": {
          "items": {
            "type": "string"
          },
          "title": "Required Fields",
          "type": "array"
        },
        "field_types": {
          "additionalProperties": {
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "object",
              "array"
            ],
            "type": "string"
          },
          "title": "Field Types",
          "type": "object"
        }
      },
      "required": [
        "schema_id"
      ],
      "title": "DataContract",
      "type": "object"
    },
    "WorkItemSpec": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "item_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Item Id",
          "type": "string"
        },
        "title": {
          "minLength": 2,
          "title": "Title",
          "type": "string"
        },
        "module": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Module",
          "type": "string"
        },
        "objective": {
          "minLength": 3,
          "title": "Objective",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "input_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "review_level": {
          "$ref": "#/$defs/AssessmentLevel",
          "default": "A0"
        },
        "max_attempts": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "rerun_of_item_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerun Of Item Id"
        },
        "repair_request_id": {
          "anyOf": [
            {
              "pattern": "^repair-[a-f0-9]{24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repair Request Id"
        },
        "fork_branch_id": {
          "anyOf": [
            {
              "pattern": "^branch-[a-f0-9]{24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fork Branch Id"
        }
      },
      "required": [
        "item_id",
        "title",
        "module",
        "objective",
        "acceptance_criteria"
      ],
      "title": "WorkItemSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "3.0.0",
      "default": "3.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/WorkItemSpec"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "planner_backend": {
      "title": "Planner Backend",
      "type": "string"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "evidence_strategy_patterns": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Evidence Strategy Patterns",
      "type": "array"
    },
    "paper_evidence": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Paper Evidence",
      "type": "array"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "items",
    "planner_backend",
    "rationale"
  ],
  "title": "ResearchPlan",
  "type": "object"
}
