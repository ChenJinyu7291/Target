{
  "additionalProperties": false,
  "description": "Small deterministic boundary contract; no runtime JSON-schema dependency.",
  "properties": {
    "contract_version": {
      "const": "3.1.0",
      "default": "3.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "schema_id": {
      "minLength": 1,
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "required_fields": {
      "items": {
        "type": "string"
      },
      "title": "Required Fields",
      "type": "array"
    },
    "field_types": {
      "additionalProperties": {
        "enum": [
          "string",
          "number",
          "integer",
          "boolean",
          "object",
          "array"
        ],
        "type": "string"
      },
      "title": "Field Types",
      "type": "object"
    }
  },
  "required": [
    "schema_id"
  ],
  "title": "DataContract",
  "type": "object"
}
