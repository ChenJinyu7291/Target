{
  "$defs": {
    "AssessmentLevel": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "human"
      ],
      "title": "AssessmentLevel",
      "type": "string"
    },
    "DataContract": {
      "additionalProperties": false,
      "description": "Small deterministic boundary contract; no runtime JSON-schema dependency.",
      "properties": {
        "contract_version": {
          "const": "3.1.0",
          "default": "3.1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "schema_id": {
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "required_fields": {
          "items": {
            "type": "string"
          },
          "title": "Required Fields",
          "type": "array"
        },
        "field_types": {
          "additionalProperties": {
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "object",
              "array"
            ],
            "type": "string"
          },
          "title": "Field Types",
          "type": "object"
        }
      },
      "required": [
        "schema_id"
      ],
      "title": "DataContract",
      "type": "object"
    },
    "WorkItemSpec": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "3.1.0",
          "default": "3.1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "item_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Item Id",
          "type": "string"
        },
        "title": {
          "minLength": 2,
          "title": "Title",
          "type": "string"
        },
        "module": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Module",
          "type": "string"
        },
        "objective": {
          "minLength": 3,
          "title": "Objective",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "input_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "review_level": {
          "$ref": "#/$defs/AssessmentLevel",
          "default": "A0"
        },
        "max_attempts": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "rerun_of_item_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerun Of Item Id"
        },
        "repair_request_id": {
          "anyOf": [
            {
              "pattern": "^repair-[a-f0-9]{24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repair Request Id"
        },
        "fork_branch_id": {
          "anyOf": [
            {
              "pattern": "^branch-[a-f0-9]{24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fork Branch Id"
        }
      },
      "required": [
        "item_id",
        "title",
        "module",
        "objective",
        "acceptance_criteria"
      ],
      "title": "WorkItemSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Append-only execution overlay; never a free-form replacement plan.",
  "properties": {
    "contract_version": {
      "const": "3.1.0",
      "default": "3.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "revision_id": {
      "pattern": "^revision-[a-f0-9]{24}$",
      "title": "Revision Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "base_plan_id": {
      "title": "Base Plan Id",
      "type": "string"
    },
    "parent_revision_id": {
      "anyOf": [
        {
          "pattern": "^revision-[a-f0-9]{24}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Revision Id"
    },
    "revision_number": {
      "maximum": 30,
      "minimum": 1,
      "title": "Revision Number",
      "type": "integer"
    },
    "repair_request_id": {
      "anyOf": [
        {
          "pattern": "^repair-[a-f0-9]{24}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repair Request Id"
    },
    "fork_branch_id": {
      "anyOf": [
        {
          "pattern": "^branch-[a-f0-9]{24}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fork Branch Id"
    },
    "operation": {
      "default": "rerun_subgraph_same_inputs",
      "enum": [
        "rerun_subgraph_same_inputs",
        "switch_dataset_same_context",
        "supplement_evidence",
        "exclude_evidence",
        "downgrade_claim",
        "split_context_same_scope",
        "fork_rollback"
      ],
      "title": "Operation",
      "type": "string"
    },
    "directive_id": {
      "anyOf": [
        {
          "pattern": "^directive-[a-f0-9]{24}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Directive Id"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "added_items": {
      "items": {
        "$ref": "#/$defs/WorkItemSpec"
      },
      "minItems": 1,
      "title": "Added Items",
      "type": "array"
    },
    "superseded_item_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Superseded Item Ids",
      "type": "array"
    },
    "superseded_assessment_ids": {
      "items": {
        "type": "string"
      },
      "title": "Superseded Assessment Ids",
      "type": "array"
    },
    "trigger_snapshot_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Trigger Snapshot Digest",
      "type": "string"
    },
    "revision_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision Digest",
      "type": "string"
    },
    "approval_required": {
      "title": "Approval Required",
      "type": "boolean"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "revision_id",
    "project_id",
    "base_plan_id",
    "revision_number",
    "added_items",
    "superseded_item_ids",
    "trigger_snapshot_digest",
    "revision_digest",
    "approval_required"
  ],
  "title": "ResearchPlanRevision",
  "type": "object"
}
