{
  "$defs": {
    "FailureClass": {
      "enum": [
        "transient",
        "permanent",
        "missing_input",
        "scientific_gap",
        "integrity_failure",
        "unsupported",
        "internal"
      ],
      "title": "FailureClass",
      "type": "string"
    },
    "WorkAttemptStatus": {
      "enum": [
        "pending",
        "running",
        "completed",
        "completed_with_gaps",
        "failed",
        "cancelled"
      ],
      "title": "WorkAttemptStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable attempt record for one work-item execution.",
  "properties": {
    "contract_version": {
      "const": "3.1.0",
      "default": "3.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "attempt_id": {
      "pattern": "^attempt-[a-f0-9]{24}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "work_item_id": {
      "title": "Work Item Id",
      "type": "string"
    },
    "attempt_number": {
      "maximum": 3,
      "minimum": 1,
      "title": "Attempt Number",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/WorkAttemptStatus"
    },
    "input_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "output_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Digest"
    },
    "worker_lease_id": {
      "anyOf": [
        {
          "pattern": "^lease-[a-f0-9]{24}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Lease Id"
    },
    "supersedes_attempt_id": {
      "anyOf": [
        {
          "pattern": "^attempt-[a-f0-9]{24}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Attempt Id"
    },
    "failure_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "attempt_id",
    "project_id",
    "work_item_id",
    "attempt_number",
    "status",
    "input_digest"
  ],
  "title": "WorkAttempt",
  "type": "object"
}
