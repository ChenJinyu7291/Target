{
  "$defs": {
    "DecisionAction": {
      "enum": [
        "accept",
        "reject",
        "replan",
        "request_evidence",
        "override",
        "release"
      ],
      "title": "DecisionAction",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "3.1.0",
      "default": "3.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "action": {
      "$ref": "#/$defs/DecisionAction"
    },
    "target_ids": {
      "items": {
        "type": "string"
      },
      "title": "Target Ids",
      "type": "array"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "actor": {
      "title": "Actor",
      "type": "string"
    },
    "evidence_snapshot_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Snapshot Digest"
    },
    "reversible": {
      "default": true,
      "title": "Reversible",
      "type": "boolean"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "action",
    "target_ids",
    "rationale",
    "actor"
  ],
  "title": "DecisionEvent",
  "type": "object"
}
