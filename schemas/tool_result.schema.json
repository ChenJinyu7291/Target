{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "2.2.0",
          "default": "2.2.0",
          "title": "Contract Version",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        }
      },
      "required": [
        "name",
        "uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CoverageStatus": {
      "enum": [
        "covered",
        "partial",
        "not_covered",
        "unknown"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "ToolCapability": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "2.2.0",
          "default": "2.2.0",
          "title": "Contract Version",
          "type": "string"
        },
        "supported_organisms": {
          "items": {
            "type": "string"
          },
          "title": "Supported Organisms",
          "type": "array"
        },
        "supported_tissues": {
          "items": {
            "type": "string"
          },
          "title": "Supported Tissues",
          "type": "array"
        },
        "supported_cell_types": {
          "items": {
            "type": "string"
          },
          "title": "Supported Cell Types",
          "type": "array"
        },
        "supported_perturbations": {
          "items": {
            "type": "string"
          },
          "title": "Supported Perturbations",
          "type": "array"
        },
        "training_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Scope"
        },
        "validation_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Scope"
        },
        "supported_genome_builds": {
          "items": {
            "enum": [
              "GRCh37",
              "GRCh38"
            ],
            "type": "string"
          },
          "title": "Supported Genome Builds",
          "type": "array"
        },
        "supported_ancestries": {
          "items": {
            "type": "string"
          },
          "title": "Supported Ancestries",
          "type": "array"
        },
        "supported_methods": {
          "items": {
            "type": "string"
          },
          "title": "Supported Methods",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "title": "ToolCapability",
      "type": "object"
    },
    "ToolStatus": {
      "enum": [
        "success",
        "partial",
        "failed",
        "out_of_scope"
      ],
      "title": "ToolStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "2.2.0",
      "default": "2.2.0",
      "title": "Contract Version",
      "type": "string"
    },
    "tool_run_id": {
      "title": "Tool Run Id",
      "type": "string"
    },
    "tool_name": {
      "title": "Tool Name",
      "type": "string"
    },
    "tool_version": {
      "title": "Tool Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ToolStatus"
    },
    "coverage_status": {
      "$ref": "#/$defs/CoverageStatus"
    },
    "context_match_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Context Match Score",
      "type": "number"
    },
    "inputs": {
      "additionalProperties": true,
      "title": "Inputs",
      "type": "object"
    },
    "outputs": {
      "additionalProperties": true,
      "title": "Outputs",
      "type": "object"
    },
    "candidate_genes": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Genes",
      "type": "array"
    },
    "capability": {
      "$ref": "#/$defs/ToolCapability"
    },
    "data_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data Version"
    },
    "code_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Version"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "cached": {
      "default": false,
      "title": "Cached",
      "type": "boolean"
    },
    "supersedes_tool_run_id": {
      "anyOf": [
        {
          "pattern": "^tool-[a-f0-9]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Tool Run Id"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "elapsed_ms": {
      "default": 0,
      "minimum": 0,
      "title": "Elapsed Ms",
      "type": "integer"
    }
  },
  "required": [
    "tool_name",
    "tool_version",
    "status",
    "coverage_status",
    "context_match_score",
    "capability"
  ],
  "title": "ToolResult",
  "type": "object"
}
